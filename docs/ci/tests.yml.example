name: Python tests
on:
  push:
    branches: [main, feat/data-pipeline, feat/causal-models]
  pull_request:
    branches: [main]
permissions:
  contents: read
jobs:
  tests:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ['3.11', '3.13']
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - run: python -m pip install --upgrade pip
      - run: python -m pip install -e '.[eda,dashboard,dev]'
      - run: python -m compileall -q src scripts app.py
      - run: python -m pytest
